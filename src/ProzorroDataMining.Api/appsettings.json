{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prozorro-data-mining-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Properties": {
      "Application": "ProzorroDataMining.Api"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=prozorro_data_mining;Username=CHANGE_ME;Password=CHANGE_ME"
  },
  "ProzorroApi": {
    "BaseAddress": "https://public-api.prozorro.gov.ua/api/2.5/",
    "RequestTimeoutSeconds": 30,
    "DefaultPageSize": 500,
    "DefaultMaxPages": 20,
    "MaxConcurrentDetailRequests": 8,
    "MaxRequestsPerSecond": 100,
    "TooManyRequestsMaxRetries": 3,
    "TooManyRequestsRetryDelayMs": 1000
  },
  "AllowedHosts": "*"
}